<model>
    <mount>//OPNsense/PortGuard</mount>
    <version>1.0.0</version>
    <description>Port guard</description>
    <items>
        <!--
            plugins.inc.d/portguard.inc and apply.php read these; the rules hook reads config.xml by
            element name during a filter reload.
        -->
        <general>
            <enabled type="BooleanField">
                <Required>Y</Required>
                <Default>1</Default>
            </enabled>
            <log type="BooleanField">
                <Required>Y</Required>
                <Default>0</Default>
            </log>
        </general>
        <devices>
            <device type="ArrayField">
                <enabled type="BooleanField">
                    <Required>Y</Required>
                    <Default>1</Default>
                </enabled>
                <!-- a whole address, or the first bytes of one: every device of that maker -->
                <mac type="TextField">
                    <Required>Y</Required>
                    <Mask>/^([0-9a-fA-F]{2}[:-]){2,5}[0-9a-fA-F]{2}$/</Mask>
                    <ValidationMessage>A MAC address, 02:00:00:aa:bb:cc, or its first three to five bytes for every device of one maker.</ValidationMessage>
                    <Constraints>
                        <check001>
                            <ValidationMessage>This address is listed already.</ValidationMessage>
                            <type>UniqueConstraint</type>
                        </check001>
                    </Constraints>
                </mac>
                <description type="DescriptionField">
                    <Required>N</Required>
                </description>
            </device>
        </devices>
    </items>
</model>
